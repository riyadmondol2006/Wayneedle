    <!-- Location permission and GPS states -->
    <string name="gate_no_gps_title">This device has no GPS</string>
    <string name="gate_no_gps_body">Wayneedle measures speed with a GPS receiver. This device doesn’t have one, so it can’t show your speed or record trips.</string>
    <string name="gate_rationale_title">Allow precise location</string>
    <string name="gate_rationale_body">Wayneedle needs your precise location to measure speed and distance from GPS. Your location is used only on this phone and never leaves it.</string>
    <string name="gate_retry_title">Location access is needed</string>
    <string name="gate_retry_body">Without precise location Wayneedle can’t measure your speed. Please allow it to continue.</string>
    <string name="gate_blocked_title">Location access is blocked</string>
    <string name="gate_blocked_body">Android won’t ask again because location was turned off for Wayneedle. Open app settings, choose Permissions, then Location, and allow precise location.</string>
    <string name="gate_approximate_title">Precise location is required</string>
    <string name="gate_approximate_body">Only approximate location was shared, which can’t measure speed. Allow precise location for Wayneedle.</string>
    <string name="gate_gps_off_title">Location is turned off</string>
    <string name="gate_gps_off_body">Turn on location in your phone’s settings so Wayneedle can get a GPS fix.</string>
    <string name="gate_action_allow">Allow location</string>
    <string name="gate_action_try_again">Try again</string>
    <string name="gate_action_allow_precise">Allow precise location</string>
    <string name="gate_action_open_app_settings">Open app settings</string>
    <string name="gate_action_turn_on_location">Turn on location</string>
    <string name="gate_banner_gps_off">GPS is off. Speed and distance are not being measured.</string>
    <string name="gate_banner_permission">Precise location access is missing. Speed and distance are not being measured.</string>

    <!-- Dialogs -->
    <string name="dialog_finish_title">Finish and save trip?</string>
    <string name="dialog_finish_body">%1$s %2$s in %3$s will be saved to History.</string>
    <string name="dialog_finish_body_empty">No distance has been recorded yet. The trip will still be saved.</string>
    <string name="dialog_discard_title">Discard this trip?</string>
    <string name="dialog_discard_body">The trip and everything it recorded so far will be permanently deleted. This can’t be undone.</string>
    <string name="dialog_save_failed_title">Couldn’t save the trip</string>
    <string name="dialog_save_failed_body">Your trip is safe and still paused. Check that your phone has free storage, then try again.</string>
    <string name="dialog_delete_trip_title">Delete this trip?</string>
    <string name="dialog_delete_trip_body">The trip from %1$s will be permanently deleted. This can’t be undone.</string>
    <string name="dialog_delete_all_title">Delete all trips?</string>
